# Browser config. Anything prefixed VITE_ is compiled into the client bundle,
# so only ever put publishable values here — never the database password.
#
# Supabase dashboard -> Project Settings -> API
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
